# Conexão com o PostgreSQL (única forma de conectar)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexo?schema=public"
# Assinatura dos tokens JWT — gere um valor longo e aleatório
JWT_SECRET="troque-este-valor"
# Validade do token (ex.: 8h, 1d)
JWT_EXPIRES_IN="8h"
# Porta da API
PORT=3000
# Origem do frontend liberada no CORS
CORS_ORIGIN="http://localhost:5173"
# Banco usado pelos testes e2e (é limpo a cada execução)
DATABASE_URL_TESTE="postgresql://postgres:postgres@localhost:5432/nexo_test?schema=public"
