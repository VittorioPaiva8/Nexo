# Nexo no Render (plano gratuito, só para teste): um serviço só, com a API em /api e o site no mesmo endereço.
# No plano gratuito o Render não roda comando antes do deploy, então as migrações
# e os dados iniciais rodam ao ligar o container (o seed não duplica dados).
FROM node:24-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build npm ci --include=dev
COPY web/package.json web/package-lock.json ./web/
RUN cd web && npm ci --include=dev
COPY tsconfig.json tsconfig.build.json ./
COPY src ./src
COPY web ./web
RUN npm run build && cd web && VITE_API_URL=/api npm run build
ENV SITE_DIR=/app/web/dist
EXPOSE 3000
CMD ["sh", "-c", "npx prisma migrate deploy && npx tsx prisma/seed.ts && node dist/main.js"]
